{
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "csv-parse": "^5.5.5",
    "discord-rpc": "^4.0.1",
    "mpris-service": "^2.1.2",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9"
  },
  "name": "playerinyo",
  "productName": "Playerinyo",
  "version": "0.1.1",
  "description": "Offline music player",
  "main": "app/main.js",
  "scripts": {
    "test": "node --test",
    "package": "node scripts/package.js",
    "package:linux": "node scripts/package.js --platform=linux --arch=x64",
    "package:mac": "node scripts/package.js --platform=darwin --arch=arm64",
    "package:windows": "node scripts/package.js --platform=win32 --arch=x64",
    "start": "electron .",
    "linux:install-desktop": "bash scripts/install-linux-desktop.sh"
  },
  "overrides": {
    "register-scheme": "0.0.2",
    "ws": "^7.5.11",
    "xml2js": "^0.6.2"
  },
  "keywords": [],
  "author": "Zafer",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@electron/rebuild": "4.2.0",
    "electron": "^41.2.1"
  },
  "allowScripts": {
    "abstract-socket@2.1.1": true,
    "electron@41.2.1": true,
    "register-scheme": false
  }
}
